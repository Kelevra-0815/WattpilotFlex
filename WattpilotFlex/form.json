{
    "elements": [
        {
            "type": "Label",
            "caption": "☕ Gefällt dir dieses Modul? Unterstütze die Entwicklung:"
        },
        {
            "type": "Button",
            "caption": "💛 PayPal Donate",
            "onClick": "echo 'https://www.paypal.com/donate/?hosted_button_id=4HVXKG7QKF4WW';"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Optionale Variablen – Messwerte",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Wähle welche zusätzlichen Messwert-Variablen erstellt werden sollen.\nDeaktivierte Variablen werden beim Speichern gelöscht."
                },
                { "name": "ShowCurrent",     "type": "CheckBox", "caption": "Strom (L1, L2, L3)" },
                { "name": "ShowVoltage",     "type": "CheckBox", "caption": "Spannung (L1, L2, L3)" },
                { "name": "ShowPowerFactor", "type": "CheckBox", "caption": "Leistungsfaktor (L1, L2, L3)" },
                { "name": "ShowTemperature", "type": "CheckBox", "caption": "Temperaturen" },
                { "name": "ShowFrequency",   "type": "CheckBox", "caption": "Netzfrequenz" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Optionale Variablen – Laden & Steuerung",
            "expanded": true,
            "items": [
                { "name": "ShowPhaseDetail",     "type": "CheckBox", "caption": "Phasen-Details (aktive Phasen L1/L2/L3)" },
                { "name": "ShowChargeAdvanced",  "type": "CheckBox", "caption": "Laden erweitert (Max./Min. Strom, Temp.-Limit, Einzelphase erzwungen)" },
                { "name": "ShowLock",            "type": "CheckBox", "caption": "Verriegelung (Kabelschloss, Status)" },
                { "name": "ShowExtras",          "type": "CheckBox", "caption": "Extras (Kabel-Limit, 16A-Adapter, Transaktion, Energie-Limit)" },
                { "name": "ShowScheduler",       "type": "CheckBox", "caption": "Ladeplaner (Zeitpläne Wochentag/Samstag/Sonntag)" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Optionale Variablen – PV & Energie",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Diese Werte sind nur verfügbar wenn ein Fronius Wechselrichter/Smartmeter gekoppelt ist."
                },
                { "name": "ShowPV",       "type": "CheckBox", "caption": "PV & Batterie Messwerte (Netz, PV, Batterie, SoC)" },
                { "name": "ShowPVConfig", "type": "CheckBox", "caption": "PV Einstellungen (Startleistung, Hysteresen, Schwellen)" },
                { "name": "ShowAwattar",  "type": "CheckBox", "caption": "Awattar / Dynamische Preise" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Optionale Variablen – System",
            "expanded": false,
            "items": [
                { "name": "ShowSystem",  "type": "CheckBox", "caption": "System (Firmware, Seriennummer, Neustarts, Laufzeit, WLAN)" },
                { "name": "ShowNetwork", "type": "CheckBox", "caption": "Netzwerk (WiFi-Status, Hostname)" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Archivierung / Logging",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Aktiviert die Archivierung (Logging) für ausgewählte Variablen."
                },
                { "name": "LogPower",  "type": "CheckBox", "caption": "Ladeleistung gesamt (WP_nrg_ptotal) – Standard-Logging" },
                { "name": "LogEnergy", "type": "CheckBox", "caption": "Gesamtenergie (WP_eto) – Zähler-Logging" },
                { "name": "LogPV",     "type": "CheckBox", "caption": "PV-Leistung (WP_pPv) – Standard-Logging" }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Status manuell aktualisieren",
            "onClick": "WP_UpdateStatus($id);"
        },
        {
            "type": "Label",
            "caption": "─── Lademodus ───────────────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "SetLademodus",
                    "caption": "Lademodus",
                    "options": [
                        { "caption": "Standard", "value": 3 },
                        { "caption": "ECO / PV-Überschuss", "value": 4 },
                        { "caption": "AutoStop", "value": 5 }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetLademodus($id, (int)$SetLademodus);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Force-Modus ─────────────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "SetForceModus",
                    "caption": "Force-Modus",
                    "options": [
                        { "caption": "Neutral", "value": 0 },
                        { "caption": "Aus", "value": 1 },
                        { "caption": "Ein", "value": 2 }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetForceModus($id, (int)$SetForceModus);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Ladestrom ───────────────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "SetLadestrom",
                    "caption": "Ladestrom",
                    "minimum": 6,
                    "maximum": 32,
                    "suffix": "A"
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetLadestrom($id, (int)$SetLadestrom);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Max. Strom-Limit ────────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "SetMaxCurrent",
                    "caption": "Max. Strom",
                    "minimum": 6,
                    "maximum": 32,
                    "suffix": "A"
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetMaxCurrent($id, (int)$SetMaxCurrent);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Phasenmodus ─────────────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "SetPhasenmodus",
                    "caption": "Phasenmodus",
                    "options": [
                        { "caption": "Auto", "value": 0 },
                        { "caption": "1-phasig", "value": 1 },
                        { "caption": "3-phasig", "value": 2 }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetPhasenmodus($id, (int)$SetPhasenmodus);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Kabelverriegelung ───────────────────────"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "SetUnlockSetting",
                    "caption": "Verriegelung",
                    "options": [
                        { "caption": "Normal", "value": 0 },
                        { "caption": "Auto Entriegeln", "value": 1 },
                        { "caption": "Immer verriegelt", "value": 2 }
                    ]
                },
                {
                    "type": "Button",
                    "caption": "Anwenden",
                    "onClick": "WP_SetUnlockSetting($id, (int)$SetUnlockSetting);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "─── Ladeplaner ──────────────────────────────"
        },
        {
            "type": "Label",
            "caption": "Zeitplan per Skript setzen: WP_SetSchedule($id, 'week', 1, '22:00', '06:00', '00:00', '00:00');"
        },
        {
            "type": "Label",
            "caption": "Tage: 'week' = Mo-Fr, 'saturday' = Sa, 'sunday' = So"
        },
        {
            "type": "Label",
            "caption": "Modus: 0 = Deaktiviert, 1 = Innerhalb, 2 = Außerhalb"
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Verbunden" },
        { "code": 201, "icon": "inactive", "caption": "Warte auf Splitter" },
        { "code": 202, "icon": "error", "caption": "Fehler" }
    ]
}